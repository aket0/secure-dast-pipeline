# DAST scan target — isolated Flask application
FROM python:3.12-slim

# Non-root user
RUN groupadd --gid 1001 appgroup \
 && useradd --uid 1001 --gid appgroup --no-create-home --shell /sbin/nologin appuser

WORKDIR /app

COPY pyproject.toml .
COPY src/ src/

RUN pip install --no-cache-dir flask

USER appuser

ENV APP_ENV=test \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

EXPOSE 5000

CMD ["python3", "-m", "flask", "--app", "src/target_app/app", "run", "--host=0.0.0.0", "--port=5000"]
